---
interface Props {
  size?: number;
  class?: string;
}
const { size = 36, class: className = "" } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  role="img"
  aria-label="gdrive-dl"
>
  <defs>
    <linearGradient id="gdrive-logo-gradient" x1="8" y1="4" x2="42" y2="44" gradientUnits="userSpaceOnUse">
      <stop stop-color="#8b5cf6" />
      <stop offset="0.55" stop-color="#fb7185" />
      <stop offset="1" stop-color="#22d3ee" />
    </linearGradient>
    <linearGradient id="gdrive-logo-arrow" x1="16" y1="14" x2="32" y2="36" gradientUnits="userSpaceOnUse">
      <stop stop-color="#ffffff" stop-opacity="0.96" />
      <stop offset="1" stop-color="#ffffff" stop-opacity="0.72" />
    </linearGradient>
  </defs>
  <rect x="3" y="3" width="42" height="42" rx="13" fill="url(#gdrive-logo-gradient)" />
  <path
    d="M24 13.5v15.2m0 0-6.2-6.2M24 28.7l6.2-6.2"
    stroke="url(#gdrive-logo-arrow)"
    stroke-width="3.2"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path
    d="M14.5 32.8c2.2 3.1 5.6 5 9.5 5s7.3-1.9 9.5-5"
    stroke="#ffffff"
    stroke-opacity="0.72"
    stroke-width="2.6"
    stroke-linecap="round"
  />
  <circle cx="35" cy="14" r="2.2" fill="#ffffff" fill-opacity="0.85" />
</svg>
